# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///nammaflow.db

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=nammaflow_backend
MQTT_PASSWORD=backend_secret_pass
MQTT_KEEPALIVE=60
MQTT_TLS_ENABLED=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=

# Security & Verification
REQUIRE_SIGNATURES=true
FRESHNESS_WINDOW_SECONDS=300
MAX_FUTURE_DRIFT_SECONDS=60
REPLAY_CACHE_SIZE=10000

# Device Pre-Shared Keys (HMAC-SHA256)
DEVICE_KEY_esp32_train_01=train_secret_key_demo_01
DEVICE_KEY_esp32_door_c1=door_c1_secret_key_demo_01
DEVICE_KEY_simulator=simulator_secret_key_demo_01

# Operational Watchdogs
SENSOR_SILENT_ALERT_SECONDS=120

# Time Scaling (1 track second = 5 real metro seconds)
TIME_SCALE_FACTOR=5.0

# Model Paths & Context
CROWD_MODEL_PATH=data/crowd_model.pkl
TIMETABLE_PATH=data/timetable.csv
CALENDAR_PATH=data/calendar.json
